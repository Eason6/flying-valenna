# Public repository allowlist. Keep local notes and temporary files untracked.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/package.json
!/src/
!/scripts/
!/tests/
!/assets/
!/audio/
!/dist/

# Source and development tools.
/src/*
!/src/*.js
!/src/*.css
!/src/template.html
/scripts/*
!/scripts/*.cjs
!/scripts/*.ps1
/tests/*
!/tests/*.test.cjs
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/standard-baseline.json
!/tests/fixtures/asset-baseline.json

# Only game artwork and final covers; keep provenance and prompts local.
/assets/**
!/assets/valenna.png
!/assets/rocket.png
!/assets/nebula-blue.png
!/assets/nebula-rose.png
!/assets/capsule-v3.png
!/assets/parachute-v3.png
!/assets/chichibei-v5.png
!/assets/failure-v2.wav
!/assets/cheer-v3.wav
!/assets/covers/
!/assets/covers/gameplay-cover-4x3-v1.png
!/assets/covers/gameplay-cover-16x9-v1.png
/audio/*
!/audio/*.mp3
!/audio/失败音效.m4s

# Published game deliveries only. Review this list before a new release.
/dist/**
!/dist/飞翔的瓦莲娜.html
!/dist/build-manifest.json
!/dist/web/
!/dist/web/releases/
!/dist/web/releases/online-r05/
!/dist/web/releases/online-r05/**
!/dist/web/manifests/
!/dist/web/manifests/online-r05.json
!/dist/web/packages/
!/dist/web/packages/valenna-online-r05.zip

# Local collaboration records, personal inputs and tool state.
AGENTS.md
工程日志.md
交接文档.md
/docs/
/evidence/
/参考图/
**/generation-prompts*.json
**/source-manifest.json
**/verification*.json
node_modules/
.browsers/
.env
.env.*
*.tmp
*.log
